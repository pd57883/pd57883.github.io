<div class="form-group">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= locals.book && book.title ? book.title : '' %>">
</div>

<div class="form-group">
    <label for="author">Author</label>
    <input type="text" id="author" name="author" value="<%= locals.book && book.author ? book.author : '' %>">
</div>

<div class="form-group">
    <label for="isbn">ISBN</label>
    <input type="text" id="isbn" name="isbn" value="<%= locals.book && book.isbn ? book.isbn : '' %>">
</div>

<div class="form-group">
    <label for="publication_year">Publication Year</label>
    <input type="number" id="publication_year" name="publication_year" value="<%= locals.book && book.publication_year ? book.publication_year : '' %>">
</div>

<div class="form-group">
    <label></label>
    <input type="submit" value="Submit">
</div>
